# 이 파일은 예시입니다. 실제 값은 .env.local(로컬) 또는 배포 서비스(Vercel) 환경변수에만 넣으세요.
# 절대 저장소에 올리지 마세요.
ANTHROPIC_API_KEY=
# 진단 agent 모델 (기본 claude-opus-5-5). 비용을 낮추려면 claude-sonnet-5-5 등으로 바꿉니다.
AI_MODEL=claude-opus-5-5
# low | medium | high  (기본 medium)
AI_EFFORT=medium
# agent 루프 최대 반복 횟수
AGENT_MAX_TURNS=8
# 서버 전체 하루 진단 상한 / IP당 10분 상한
DAILY_AI_LIMIT=300
PER_IP_LIMIT=5

# 유튜브 교육 영상 추천(선택). 비워 두면 영상 기능이 꺼지고 나머지는 그대로 동작합니다.
# Google Cloud Console → YouTube Data API v3 사용 설정 → 사용자 인증 정보 → API 키.
# 키는 'YouTube Data API v3'로만 제한하세요. 값은 .env.local / Vercel 환경변수에만 넣습니다.
YOUTUBE_API_KEY=

# 회원 기록 저장(선택, Supabase). 비워 두면 로그인·기록 기능이 숨겨집니다.
# Supabase 대시보드 → Project Settings → API(또는 Data API)의 Project URL 과 anon(또는 publishable) 키.
# 둘 다 브라우저에 공개되는 값이며, 실제 보호는 DB의 RLS 정책(supabase/member_history.sql)이 합니다.
# service_role(secret) 키는 절대 여기에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
